# --- Local inference: no external API key required ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Local embedding / reranking models (downloaded once by sentence-transformers, run on CPU) ---
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Database ---
# Zero-setup default for local dev. Swap for a Postgres URL (see docker-compose.yml)
# when you want the "real" architecture instead of the dev shortcut.
DATABASE_URL=sqlite:///./data/setuhealth.db

# --- Auth ---
# Generate your own — never let an assistant choose or see this value.
#   openssl rand -hex 32
ADMIN_SECRET_KEY=REPLACE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Retrieval tuning ---
CONFIDENCE_THRESHOLD=0.45
TOP_K_CANDIDATES=20
TOP_K_RERANKED=5
CHUNK_TOKEN_SIZE=350
CHUNK_OVERLAP_RATIO=0.15

# --- Abuse/cost control ---
RATE_LIMIT_PER_MINUTE=20
